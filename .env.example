# Example environment variables for the Amazon Ads CLI.
# Copy this file to .env and fill in your values, or run `amazonads auth login`
# to save credentials to ~/.config/amazonads-cli/config.json instead.
# Environment variables override the config file.

# Amazon Ads API credentials
AMAZON_ADS_CLIENT_ID=your_client_id_here
AMAZON_ADS_CLIENT_SECRET=your_client_secret_here
AMAZON_ADS_REFRESH_TOKEN=your_refresh_token_here

# Region: NA, EU, or FE (default NA)
AMAZON_ADS_REGION=NA

# Use the Amazon Ads sandbox endpoint (default false)
AMAZON_ADS_SANDBOX=false

# Default profile ID, so --profile is not needed on every command
AMAZON_ADS_PROFILE_ID=
