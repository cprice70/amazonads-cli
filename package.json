{
  "name": "amazonads-cli",
  "version": "2.0.0",
  "description": "CLI for Amazon Ads API",
  "author": "Chris Price",
  "license": "MIT",
  "repository": "https://github.com/cprice70/amazonads-cli",
  "homepage": "https://github.com/cprice70/amazonads-cli#readme",
  "keywords": [
    "amazon",
    "ads",
    "api",
    "cli",
    "command-line"
  ],
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "amazonads": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "tsx": "^4.18.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
